bool CSSProperty::isDescriptorOnly(CSSPropertyID id)
{
    switch (id) {
    case CSSPropertyID::CSSPropertyAdditiveSymbols:
    case CSSPropertyID::CSSPropertyFallback:
    case CSSPropertyID::CSSPropertyNegative:
    case CSSPropertyID::CSSPropertyPad:
    case CSSPropertyID::CSSPropertyPrefix:
    case CSSPropertyID::CSSPropertyRange:
    case CSSPropertyID::CSSPropertySuffix:
    case CSSPropertyID::CSSPropertySymbols:
    case CSSPropertyID::CSSPropertySystem:
    case CSSPropertyID::CSSPropertyFontDisplay:
    case CSSPropertyID::CSSPropertySizeAdjust:
    case CSSPropertyID::CSSPropertySrc:
    case CSSPropertyID::CSSPropertyUnicodeRange:
    case CSSPropertyID::CSSPropertyBasePalette:
    case CSSPropertyID::CSSPropertyOverrideColors:
    case CSSPropertyID::CSSPropertyInherits:
    case CSSPropertyID::CSSPropertyInitialValue:
    case CSSPropertyID::CSSPropertySyntax:
        return true;
    default:
        return false;
    }
}

CSSPropertySettings::CSSPropertySettings(const Settings& settings)
    : CSSOMViewSmoothScrollingEnabled { settings.CSSOMViewSmoothScrollingEnabled() }
    , accentColorEnabled { settings.accentColorEnabled() }
    , aspectRatioEnabled { settings.aspectRatioEnabled() }
    , colorFilterEnabled { settings.colorFilterEnabled() }
    , cssContainIntrinsicSizeEnabled { settings.cssContainIntrinsicSizeEnabled() }
    , cssContainerQueriesEnabled { settings.cssContainerQueriesEnabled() }
    , cssContainmentEnabled { settings.cssContainmentEnabled() }
    , cssContentVisibilityEnabled { settings.cssContentVisibilityEnabled() }
    , cssCounterStyleAtRulesEnabled { settings.cssCounterStyleAtRulesEnabled() }
    , cssCustomPropertiesAndValuesEnabled { settings.cssCustomPropertiesAndValuesEnabled() }
    , cssFontFaceSizeAdjustEnabled { settings.cssFontFaceSizeAdjustEnabled() }
    , cssIndividualTransformPropertiesEnabled { settings.cssIndividualTransformPropertiesEnabled() }
    , cssInputSecurityEnabled { settings.cssInputSecurityEnabled() }
    , cssMarginTrimEnabled { settings.cssMarginTrimEnabled() }
    , cssMotionPathEnabled { settings.cssMotionPathEnabled() }
    , cssRhythmicSizingEnabled { settings.cssRhythmicSizingEnabled() }
    , cssScrollAnchoringEnabled { settings.cssScrollAnchoringEnabled() }
    , cssScrollbarColorEnabled { settings.cssScrollbarColorEnabled() }
    , cssScrollbarGutterEnabled { settings.cssScrollbarGutterEnabled() }
    , cssScrollbarWidthEnabled { settings.cssScrollbarWidthEnabled() }
    , cssTextAlignLastEnabled { settings.cssTextAlignLastEnabled() }
    , cssTextBoxTrimEnabled { settings.cssTextBoxTrimEnabled() }
    , cssTextGroupAlignEnabled { settings.cssTextGroupAlignEnabled() }
    , cssTextJustifyEnabled { settings.cssTextJustifyEnabled() }
    , cssTextSpacingEnabled { settings.cssTextSpacingEnabled() }
    , cssWhiteSpaceLonghandsEnabled { settings.cssWhiteSpaceLonghandsEnabled() }
    , masonryEnabled { settings.masonryEnabled() }
    , masonryTrackAlignmentEnabled { settings.masonryTrackAlignmentEnabled() }
    , overscrollBehaviorEnabled { settings.overscrollBehaviorEnabled() }
    , webAnimationsCompositeOperationsEnabled { settings.webAnimationsCompositeOperationsEnabled() }
{
}

bool operator==(const CSSPropertySettings& a, const CSSPropertySettings& b)
{
    return a.CSSOMViewSmoothScrollingEnabled == b.CSSOMViewSmoothScrollingEnabled
        && a.accentColorEnabled == b.accentColorEnabled
        && a.aspectRatioEnabled == b.aspectRatioEnabled
        && a.colorFilterEnabled == b.colorFilterEnabled
        && a.cssContainIntrinsicSizeEnabled == b.cssContainIntrinsicSizeEnabled
        && a.cssContainerQueriesEnabled == b.cssContainerQueriesEnabled
        && a.cssContainmentEnabled == b.cssContainmentEnabled
        && a.cssContentVisibilityEnabled == b.cssContentVisibilityEnabled
        && a.cssCounterStyleAtRulesEnabled == b.cssCounterStyleAtRulesEnabled
        && a.cssCustomPropertiesAndValuesEnabled == b.cssCustomPropertiesAndValuesEnabled
        && a.cssFontFaceSizeAdjustEnabled == b.cssFontFaceSizeAdjustEnabled
        && a.cssIndividualTransformPropertiesEnabled == b.cssIndividualTransformPropertiesEnabled
        && a.cssInputSecurityEnabled == b.cssInputSecurityEnabled
        && a.cssMarginTrimEnabled == b.cssMarginTrimEnabled
        && a.cssMotionPathEnabled == b.cssMotionPathEnabled
        && a.cssRhythmicSizingEnabled == b.cssRhythmicSizingEnabled
        && a.cssScrollAnchoringEnabled == b.cssScrollAnchoringEnabled
        && a.cssScrollbarColorEnabled == b.cssScrollbarColorEnabled
        && a.cssScrollbarGutterEnabled == b.cssScrollbarGutterEnabled
        && a.cssScrollbarWidthEnabled == b.cssScrollbarWidthEnabled
        && a.cssTextAlignLastEnabled == b.cssTextAlignLastEnabled
        && a.cssTextBoxTrimEnabled == b.cssTextBoxTrimEnabled
        && a.cssTextGroupAlignEnabled == b.cssTextGroupAlignEnabled
        && a.cssTextJustifyEnabled == b.cssTextJustifyEnabled
        && a.cssTextSpacingEnabled == b.cssTextSpacingEnabled
        && a.cssWhiteSpaceLonghandsEnabled == b.cssWhiteSpaceLonghandsEnabled
        && a.masonryEnabled == b.masonryEnabled
        && a.masonryTrackAlignmentEnabled == b.masonryTrackAlignmentEnabled
        && a.overscrollBehaviorEnabled == b.overscrollBehaviorEnabled
        && a.webAnimationsCompositeOperationsEnabled == b.webAnimationsCompositeOperationsEnabled;
}

void add(Hasher& hasher, const CSSPropertySettings& settings)
{
    uint64_t bits = settings.CSSOMViewSmoothScrollingEnabled << 0
        | settings.accentColorEnabled << 1
        | settings.aspectRatioEnabled << 2
        | settings.colorFilterEnabled << 3
        | settings.cssContainIntrinsicSizeEnabled << 4
        | settings.cssContainerQueriesEnabled << 5
        | settings.cssContainmentEnabled << 6
        | settings.cssContentVisibilityEnabled << 7
        | settings.cssCounterStyleAtRulesEnabled << 8
        | settings.cssCustomPropertiesAndValuesEnabled << 9
        | settings.cssFontFaceSizeAdjustEnabled << 10
        | settings.cssIndividualTransformPropertiesEnabled << 11
        | settings.cssInputSecurityEnabled << 12
        | settings.cssMarginTrimEnabled << 13
        | settings.cssMotionPathEnabled << 14
        | settings.cssRhythmicSizingEnabled << 15
        | settings.cssScrollAnchoringEnabled << 16
        | settings.cssScrollbarColorEnabled << 17
        | settings.cssScrollbarGutterEnabled << 18
        | settings.cssScrollbarWidthEnabled << 19
        | settings.cssTextAlignLastEnabled << 20
        | settings.cssTextBoxTrimEnabled << 21
        | settings.cssTextGroupAlignEnabled << 22
        | settings.cssTextJustifyEnabled << 23
        | settings.cssTextSpacingEnabled << 24
        | settings.cssWhiteSpaceLonghandsEnabled << 25
        | settings.masonryEnabled << 26
        | settings.masonryTrackAlignmentEnabled << 27
        | settings.overscrollBehaviorEnabled << 28
        | settings.webAnimationsCompositeOperationsEnabled << 29;
    add(hasher, bits);
}

} // namespace WebCore

IGNORE_WARNINGS_END
