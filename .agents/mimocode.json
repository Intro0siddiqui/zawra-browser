{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "ninja -t clean": "deny",
      "ninja clean": "deny",
      "rm -rf webkit/build": "deny",
      "rm -rf webkit/build/*": "deny",
      "git clean -fdx webkit/build": "deny",
      "git clean -fd webkit/build": "deny",
      "git reset --hard": "deny",
      "git reset --hard webkit/build": "deny"
    },
    "external_directory": {
      "/tmp/**": "allow"
    }
  }
}
